# Which LLM provider to use — must be one of the keys in generator.py's
# _PROVIDERS registry. Each provider below only needs its own API key set;
# switching providers is just changing this line (no code change).
LLM_PROVIDER=groq

# Groq (default provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras (alternative — set LLM_PROVIDER=cerebras to use this instead)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter (alternative — set LLM_PROVIDER=openrouter to use this instead).
# Free-tagged models rotate — check https://openrouter.ai/models?max_price=0
# for what's currently available; some free models are also flaky (shared
# upstream capacity gets rate-limited, or return null content). nex-n2.5-pro
# is verified working as of this writing (plain text, JSON mode, and the
# full ReAct tool-call loop all confirmed) — treat it as a starting point,
# not a permanent guarantee.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./chroma_db
COLLECTION_NAME=research_papers
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
DATA_PATH=./data
MAX_AGENT_ITERATIONS=5
MEMORY_WINDOW_SIZE=8